{
  "swagger": "2.0",
  "info": {
    "title": "ffxiv-census API",
    "description": "REST API for the ffxiv-census service: census summaries, character listings and details, aggregate statistics.",
    "version": "1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns application liveness status",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Liveness probe",
        "description": "Returns application liveness status and uptime",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe",
        "description": "Performs deep health check on database subsystem",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Service is ready to receive traffic"
          },
          "503": {
            "description": "Service is unhealthy or dependencies are unreachable"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics exporter",
        "description": "Exposes standard Prometheus metrics exposition format (version 0.0.4)",
        "produces": [
          "text/plain; version=0.0.4; charset=utf-8"
        ],
        "responses": {
          "200": {
            "description": "Prometheus text formatted metrics"
          }
        }
      }
    },
    "/api/v1/census/latest": {
      "get": {
        "summary": "Census summary",
        "description": "Total and active character counts from the periodically refreshed statistics snapshot.",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Census population summary",
            "schema": {
              "$ref": "#/definitions/CensusSummary"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "503": {
            "description": "Statistics snapshot is not yet available",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/census/export": {
      "get": {
        "summary": "Export characters",
        "description": "Stream bulk census character records in CSV, JSON, or NDJSON format with optional gzip compression.",
        "produces": [
          "text/csv",
          "application/json",
          "application/x-ndjson"
        ],
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "description": "Export format (csv, json, ndjson, or jsonl).",
            "type": "string",
            "default": "csv",
            "enum": [
              "csv",
              "json",
              "ndjson",
              "jsonl"
            ],
            "required": false
          },
          {
            "name": "gzip",
            "in": "query",
            "description": "Whether to compress the stream with gzip.",
            "type": "boolean",
            "default": false,
            "required": false
          },
          {
            "name": "world",
            "in": "query",
            "description": "Filter by exact world (e.g. Louisoix).",
            "type": "string",
            "required": false
          },
          {
            "name": "datacenter",
            "in": "query",
            "description": "Filter by exact datacenter (e.g. Chaos).",
            "type": "string",
            "required": false
          },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by exact region (e.g. EU).",
            "type": "string",
            "required": false
          },
          {
            "name": "race",
            "in": "query",
            "description": "Filter by exact race (e.g. Miqo'te).",
            "type": "string",
            "required": false
          },
          {
            "name": "name",
            "in": "query",
            "description": "Case-insensitive character name substring filter.",
            "type": "string",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Streamed character records export"
          },
          "400": {
            "description": "Bad request (invalid format)",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/census/characters": {
      "get": {
        "summary": "List characters",
        "description": "Paginated list of census characters ordered by id.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return (clamped to 500).",
            "type": "integer",
            "default": 100,
            "maximum": 500,
            "minimum": 1
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of items to skip.",
            "type": "integer",
            "default": 0,
            "minimum": 0
          },
          {
            "name": "world",
            "in": "query",
            "description": "Filter by exact world (e.g. Louisoix).",
            "type": "string",
            "required": false
          },
          {
            "name": "datacenter",
            "in": "query",
            "description": "Filter by exact datacenter (e.g. Chaos).",
            "type": "string",
            "required": false
          },
          {
            "name": "region",
            "in": "query",
            "description": "Filter by exact region (e.g. EU).",
            "type": "string",
            "required": false
          },
          {
            "name": "race",
            "in": "query",
            "description": "Filter by exact race (e.g. Miqo'te).",
            "type": "string",
            "required": false
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filter by case-insensitive name substring.",
            "type": "string",
            "required": false
          },
          {
            "name": "grand_company",
            "in": "query",
            "description": "Filter by exact Grand Company (e.g. Maelstrom).",
            "type": "string",
            "required": false
          },
          {
            "name": "free_company_id",
            "in": "query",
            "description": "Filter by exact Free Company ID.",
            "type": "string",
            "required": false
          },
          {
            "name": "active",
            "in": "query",
            "description": "Filter for active characters only.",
            "type": "boolean",
            "required": false
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort column (id, name, world, created_at, updated_at).",
            "type": "string",
            "enum": [
              "id",
              "name",
              "world",
              "created_at",
              "updated_at"
            ],
            "default": "id",
            "required": false
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Sort direction (asc, desc).",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "default": "asc",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated character list",
            "schema": {
              "$ref": "#/definitions/PaginatedCharacters"
            }
          },
          "400": {
            "description": "Invalid limit or offset",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/census/characters/{id}": {
      "get": {
        "summary": "Character detail",
        "description": "Full census record for one character: profile, class jobs, milestones, and free company.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Lodestone character id.",
            "required": true,
            "type": "integer",
            "format": "int64"
          }
        ],
        "responses": {
          "200": {
            "description": "Character detail",
            "schema": {
              "$ref": "#/definitions/CharacterDetail"
            }
          },
          "404": {
            "description": "Character not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/stats/breakdown": {
      "get": {
        "summary": "Population breakdown",
        "description": "Total and active character counts grouped by a census dimension from the periodically refreshed statistics snapshot.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "by",
            "in": "query",
            "description": "Dimension to group by.",
            "required": true,
            "type": "string",
            "enum": [
              "race",
              "world",
              "datacenter",
              "region"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Per-group total and active counts, ordered by total descending",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/BreakdownGroup"
              }
            }
          },
          "400": {
            "description": "Missing or invalid dimension",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "503": {
            "description": "Statistics snapshot is not yet available",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/stats/new-characters": {
      "get": {
        "summary": "New characters per day",
        "description": "Daily counts of characters who earned the Chocobo milestone (achievement 590). Defaults to the new-characters window (census.new_characters_window_days, 90 by default): its complete UTC days before the snapshot day. A range must stay inside the snapshot's current and previous windows.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "Inclusive start date (YYYY-MM-DD, UTC); defaults to the start of the new-characters window.",
            "required": false,
            "type": "string",
            "format": "date"
          },
          {
            "name": "until",
            "in": "query",
            "description": "Exclusive end date (YYYY-MM-DD, UTC); defaults to the snapshot day (the end of the window).",
            "required": false,
            "type": "string",
            "format": "date"
          }
        ],
        "responses": {
          "200": {
            "description": "Per-day counts ordered ascending",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/NewCharactersDay"
              }
            }
          },
          "400": {
            "description": "Missing, invalid, or out-of-snapshot date range",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "503": {
            "description": "Statistics snapshot is not yet available",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/stats/expansion": {
      "get": {
        "summary": "Expansion completions",
        "description": "Number of characters who completed each expansion's main scenario quest from the periodically refreshed statistics snapshot, optionally filtered by name.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "Filter to a single expansion name.",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Per-expansion completion counts",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ExpansionStat"
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "503": {
            "description": "Statistics snapshot is not yet available",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "description": "Error envelope returned on non-200 responses.",
      "properties": {
        "error": {
          "type": "string"
        }
      }
    },
    "CensusSummary": {
      "type": "object",
      "required": [
        "total_characters",
        "active_characters",
        "active_ratio",
        "max_level_characters"
      ],
      "properties": {
        "total_characters": {
          "type": "integer",
          "format": "int64"
        },
        "active_characters": {
          "type": "integer",
          "format": "int64"
        },
        "active_ratio": {
          "type": "number",
          "format": "double"
        },
        "max_level_characters": {
          "type": "integer",
          "format": "int64"
        },
        "activity_window_days": {
          "type": "integer",
          "description": "Activity window behind active_characters, in days: a character is active when its latest public achievement is this recent."
        }
      }
    },
    "CharacterListItem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "world",
        "datacenter",
        "region",
        "race",
        "gender",
        "achievements_private",
        "first_seen_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "world": {
          "type": "string"
        },
        "datacenter": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "race": {
          "type": "string"
        },
        "gender": {
          "type": "integer",
          "format": "int32"
        },
        "free_company_id": {
          "type": "string"
        },
        "free_company_name": {
          "type": "string"
        },
        "achievements_private": {
          "type": "boolean"
        },
        "latest_achievement_id": {
          "type": "integer",
          "format": "int64"
        },
        "first_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_census_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PaginatedCharacters": {
      "type": "object",
      "required": [
        "items",
        "total",
        "limit",
        "offset"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CharacterListItem"
          }
        },
        "total": {
          "type": "integer",
          "format": "int64"
        },
        "limit": {
          "type": "integer",
          "format": "int32"
        },
        "offset": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "CharacterDetail": {
      "type": "object",
      "required": [
        "character",
        "jobs",
        "milestones"
      ],
      "properties": {
        "character": {
          "$ref": "#/definitions/CharacterListItem"
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CharacterJobDetail"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CharacterMilestoneDetail"
          }
        },
        "free_company": {
          "$ref": "#/definitions/FreeCompanyDetail"
        }
      }
    },
    "CharacterJobDetail": {
      "type": "object",
      "required": [
        "class_job_id",
        "name",
        "level",
        "exp_level"
      ],
      "properties": {
        "class_job_id": {
          "type": "integer",
          "format": "int32"
        },
        "name": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "format": "int32"
        },
        "exp_level": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "CharacterMilestoneDetail": {
      "type": "object",
      "required": [
        "achievement_id",
        "achieved_at"
      ],
      "properties": {
        "achievement_id": {
          "type": "integer",
          "format": "int64"
        },
        "achieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "FreeCompanyDetail": {
      "type": "object",
      "required": [
        "id",
        "name",
        "world",
        "datacenter",
        "member_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "world": {
          "type": "string"
        },
        "datacenter": {
          "type": "string"
        },
        "member_count": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "BreakdownGroup": {
      "type": "object",
      "required": [
        "key",
        "total",
        "active"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "format": "int64"
        },
        "active": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "NewCharactersDay": {
      "type": "object",
      "required": [
        "day",
        "count"
      ],
      "properties": {
        "day": {
          "type": "string",
          "format": "date"
        },
        "count": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ExpansionStat": {
      "type": "object",
      "required": [
        "expansion",
        "count"
      ],
      "properties": {
        "expansion": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "format": "int64"
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Enter your token (e.g. '09136457...' or 'Bearer 09136457...')"
    }
  }
}
